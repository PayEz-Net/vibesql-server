{
  "VibeSQL": {
    "ContainerSecret": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    },
    "Graylog": {
      "HostnameOrAddress": "localhost",
      "Port": "12201"
    }
  },
  "ConnectionStrings": {
    "VibeDb": "Server=localhost;Port=5432;Database=vibesql;User Id=vibesql_user;Password=CHANGE_ME;SSLMode=Disable;Pooling=true;",
    "VibeDbRls": "Server=localhost;Port=5432;Database=vibesql;User Id=vibe_rls_user;Password=CHANGE_ME;SSLMode=Disable;Pooling=true;"
  },
  "VibeQueryTimeouts": {
    "FreeSeconds": 2,
    "StarterSeconds": 5,
    "ProSeconds": 10,
    "EnterpriseSeconds": 30,
    "DefaultSeconds": 5
  },
  "VibeQueryLimits": {
    "MaxResultRows": 1000,
    "MaxQuerySizeBytes": 10240
  }
}
