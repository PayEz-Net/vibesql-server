<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RootNamespace>VibeSQL.Core</RootNamespace>
    <AssemblyName>VibeSQL.Core</AssemblyName>
    <Product>VibeSQL Server</Product>
    <Description>Core engine, entities, repositories, services, and DTOs for VibeSQL Server</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- PostgreSQL drivers -->
    <!-- Npgsql: raw SQL query engine (VibeSQL Server API) -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <!-- Devart dotConnect: EF Core repositories and migrations -->
    <PackageReference Include="Devart.Data.PostgreSql" Version="8.4.193" />

    <!-- Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
    <PackageReference Include="Devart.Data.PostgreSql.EFCore" Version="8.4.193" />

    <!-- HTML Sanitization -->
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />

    <!-- Microsoft extensions -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL migrations as embedded resources -->
    <EmbeddedResource Include="Data\Migrations\**\*.sql" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="VibeSQL.Core.Tests" />
  </ItemGroup>


  <!-- Schema is loaded at runtime by VibeSchemaInitializer from this embedded copy,
       so the DDL has exactly one source of truth. Renaming or moving the file without
       updating VibeSchemaInitializer.SchemaResourceName fails loudly at startup. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\base-schema.v2.sql" Link="scripts\base-schema.v2.sql" LogicalName="VibeSQL.Core.scripts.base-schema.v2.sql" />
  </ItemGroup>
</Project>
