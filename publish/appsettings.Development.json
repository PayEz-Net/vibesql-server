{
  "VibeSQL": {
    "ContainerSecret": "dev-only-secret-change-in-prod",
    "Sentinel": {
      "Enabled": true,
      "BlockDestructive": true,
      "BlockProhibited": true,
      "MigrationTimeoutSeconds": 30,
      "InspectorBudgetMs": 500,
      "PerQueryTimeoutMs": 5000,
      "RequireInspectorForDestructive": true,
      "ExactCountThreshold": 100000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "VibeDb": "Host=10.0.0.93;Port=5432;Database=payez_vibe;Username=postgres;Password=password;SSL Mode=Disable;Pooling=true;"
  }
}
